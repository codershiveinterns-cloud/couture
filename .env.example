# Copy to .env.local (git-ignored) and fill in real values. Never commit secrets.

# --- Public (safe to expose; inlined into the browser bundle) ---------------------
# Canonical origin of the deployment. Used for canonical URLs, Open Graph, robots.txt,
# sitemap.xml and JSON-LD. No trailing slash. Falls back to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Server-only secrets (NO NEXT_PUBLIC_ prefix — never exposed to the browser) -----
# Placeholders for the production payment gateway. The current build runs the
# test-mode gateway in src/lib/payments and does not read these yet.
PAYMENT_GATEWAY_KEY=
PAYMENT_GATEWAY_SECRET=

# Transactional email provider API key (order confirmation, shipping updates, password
# reset). Not read by the demo notification layer yet.
EMAIL_API_KEY=
